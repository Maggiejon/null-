# ========================================
# Odoo 部署环境变量配置
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ========================================

# 数据库配置
DB_USER=odoo
DB_PASSWORD=your_strong_db_password_here

# 域名（没有域名填服务器IP）
DOMAIN=your-domain.com

# Odoo 管理员主密码（用于创建/删除数据库）
ADMIN_PASSWD=your_strong_admin_password_here
